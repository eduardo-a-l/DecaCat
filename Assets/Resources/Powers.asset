MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b1d7c0e3f6a4a1f9d2e8c47a0b3f6e1, type: 3}
  m_Name: Powers
  m_EditorClassIdentifier: Assembly-CSharp::PowerCatalog
  powers:
  - type: 0
    displayName: Ice Power
    icon: {fileID: 8467120115558283214, guid: 13f064cb5478f374990be7ace6d65adb, type: 3}
    playerSprite: {fileID: 3704502696723664069, guid: ee33b8427e4e53948868819c6e9078bc, type: 3}
    accent: {r: 0.55, g: 0.85, b: 1, a: 1}
    passive: 'Enemies you hit are slowed for 5 seconds, with a 10% chance of freezing them in place for 10 seconds. 80% chance to evade ice attacks.'
    special: 'Slows down every enemy in the room for 20 seconds.'
    negative: 'Your speed is cut by 50%.'
  - type: 1
    displayName: Fire Power
    icon: {fileID: -5757420161773779218, guid: c03085cf935f4a340bbcf18ad33b2d78, type: 3}
    playerSprite: {fileID: 7767431460072092978, guid: dcd66ef5290446640ad7cb3057f27d13, type: 3}
    accent: {r: 1, g: 0.45, b: 0.2, a: 1}
    passive: 'You leave a trail of fire that lasts 5 seconds. Enemies that step on it burn for 2 seconds, taking 1 damage every second. All your attacks deal 20% more damage. 80% chance to evade fire attacks.'
    special: 'Makes a fire explosion where you stand, dealing 20 damage and burning every enemy in the area.'
    negative: 'Enemies killed while burning explode in a small burst that damages everything nearby, including you.'
  - type: 2
    displayName: Cloud Power
    icon: {fileID: -3537284685608248971, guid: b8bebe8bee62a5d44951f459a449fb8d, type: 3}
    playerSprite: {fileID: 627801884037311512, guid: cd3362aba71d81f458bbe5b5100dbf51, type: 3}
    accent: {r: 0.9, g: 0.9, b: 0.95, a: 1}
    passive: 'A fog around you slows nearby enemies. Every attack knocks enemies back.'
    special: 'Makes rain for 20 seconds that slows enemies. The rain carries over between rooms and floors, and you cannot use this special again until it ends. 20% chance the rain is a thunderstorm that randomly stuns enemies.'
    negative: 'Dropping a weapon makes it lose half of its durability.'
  - type: 3
    displayName: Leaf Power
    icon: {fileID: 6281246302079624109, guid: ae3aff4575731a5439856326a81d304d, type: 3}
    playerSprite: {fileID: 3725837656178886585, guid: 6e98879e9c8f42d4a9292e85e6f54236, type: 3}
    accent: {r: 0.35, g: 0.8, b: 0.3, a: 1}
    passive: 'Moving builds a swirling ring of up to 4 floating razor leaves around you. They damage enemies that touch them and break on contact.'
    special: 'Heals one heart.'
    negative: 'You deal 50% less damage.'
  - type: 4
    displayName: Ghost Power
    icon: {fileID: 1333219987120373581, guid: 13b5e88138e913e448fe31215fcab0df, type: 3}
    playerSprite: {fileID: 484727422052415027, guid: 540ad09e8cd786f43867d964746e486a, type: 3}
    accent: {r: 0.75, g: 0.75, b: 0.85, a: 1}
    passive: 'You can move through the walls inside a room, but not through the room borders.'
    special: 'Instantly teleports you a short distance in the direction you are moving and leaves a spectral decoy behind. The decoy taunts nearby enemies for 3 seconds, then explodes into ectoplasmic fire.'
    negative: 'After you leave a wall, your main attack is locked for 1.5 seconds.'
  - type: 5
    displayName: Water Power
    icon: {fileID: -1658648467437705823, guid: b614ea591e1620e4d84dda307ad0c320, type: 3}
    playerSprite: {fileID: 5147866115859380170, guid: 03f2bc8b46b9ffd4db841725e203f06c, type: 3}
    accent: {r: 0.2, g: 0.8, b: 0.85, a: 1}
    passive: 'Each successful basic attack builds energy. At 4 stacks, your next attack unleashes a sweeping tidal wave that knocks enemies back, pierces obstacles and hits several enemies.'
    special: 'Summons three small minions that chase the closest enemy. Each one has 5 hearts, the same invulnerability as you, and damages enemies on contact.'
    negative: 'Taking damage stops you from using your special for 10 seconds.'
  - type: 6
    displayName: Electric Power
    icon: {fileID: 4197577190373681944, guid: 4d427324fcb124d42b289f30c1e454ec, type: 3}
    playerSprite: {fileID: 5405297293540544648, guid: 553bfe25f43e64540b6e351a28d3e318, type: 3}
    accent: {r: 1, g: 0.9, b: 0.25, a: 1}
    passive: 'Moving builds energy, making your next attack stronger and giving it a chance to stun the enemy. Your attack cooldown is cut by 50%.'
    special: 'Turns you into a thunderbolt that deals strong electric area damage to every enemy it passes. It moves through walls and obstacles.'
    negative: 'Every enemy in the room moves faster.'
  - type: 7
    displayName: Bunny Power
    icon: {fileID: 6191477837923151509, guid: 883603c8891ac964eb527d7f2b4b5703, type: 3}
    playerSprite: {fileID: 3536412033779261668, guid: bd6471badbccaf846b034700c3f2d8f3, type: 3}
    accent: {r: 1, g: 1, b: 1, a: 1}
    passive: 'A shield surrounds you and blocks any damage from enemies. When an enemy hits it, it breaks for 30 seconds.'
    special: 'Dashes in the direction you are moving, damaging every enemy on the path, and makes you invulnerable for 5 seconds.'
    negative: 'You are not a cat :('
  - type: 8
    displayName: Crystal Power
    icon: {fileID: -591224641111942205, guid: 47ccd6685a07e2e4ebd4d1086f758813, type: 3}
    playerSprite: {fileID: 2531208049316094303, guid: b658b79bdd2894347b42ce5fa86ffe78, type: 3}
    accent: {r: 0.9, g: 0.55, b: 0.95, a: 1}
    passive: 'Attacking shoots a crystal projectile that splits into 2 auto-homing light beams when it hits an enemy or a wall.'
    special: 'Deploys a floating crystal prism at your location for 10 seconds. Any crystal projectile fired through it splits into 3 amplified projectiles, each splitting into 4 auto-homing beams.'
    negative: 'Attacking builds up heat. You have to wait for it to cool down to keep attacking, and building up too much heat makes you lose a heart.'
